{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/loja.js": {
      "includeFiles": "loja-app.html"
    }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/loja", "destination": "/api/loja" },
    { "source": "/loja.html", "destination": "/api/loja" },
    { "source": "/loja/:id", "destination": "/api/loja?id=:id" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/Fotos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
